# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your actual MongoDB URI)
# Local instance example: mongodb://127.0.0.1:27017/adaptive_learning
# MongoDB Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adaptive_learning?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive_learning

# Allowed Client URL for CORS
CLIENT_URL=http://localhost:5173

# JWT Authentication Configuration
# Generate a cryptographically secure key (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI provider selection
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDERS=openrouter,gemini
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_PROMPT_CHARACTERS=20000
AI_MAX_PROVIDER_ATTEMPTS=3

# Groq configuration
# Obtain a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter configuration
# Obtain a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional Google Gemini configuration
# Obtain a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
