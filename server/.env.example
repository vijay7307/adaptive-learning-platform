# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your actual MongoDB URI)
# Local instance example: mongodb://127.0.0.1:27017/adaptive_learning
# MongoDB Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adaptive_learning?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive_learning

# Allowed Client URL for CORS
CLIENT_URL=http://localhost:5173

# JWT Authentication Configuration
# Generate a cryptographically secure key (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
